{
  "name": "movilidad-climatica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:seguridad": "npm audit --omit=dev --audit-level=low && vitest run && tsx scripts/check-cabeceras.ts",
    "check:agentes": "vitest run tests/scoring.test.ts tests/schemas.test.ts tests/prompts.test.ts tests/provider.test.ts",
    "ataque": "tsx scripts/ataque.ts",
    "eval:agentes": "node --env-file-if-exists=.env.local --import tsx scripts/eval-agentes.ts",
    "eval:promptfoo": "tsx eval/promptfoo/generar.ts && npx -y promptfoo@0.125.1 eval -c eval/promptfooconfig.yaml",
    "check:contenido": "node scripts/check-contenido.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.113",
    "@ai-sdk/react": "^4.0.168",
    "ai": "^7.0.164",
    "botid": "^1.5.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.8.0",
    "next": "16.4.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  }
}

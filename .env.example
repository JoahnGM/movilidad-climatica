# Variables de entorno de la plataforma. Copia este archivo a .env.local y completa.
# NUNCA subas claves reales al repositorio. En Vercel se configuran en
# Project → Settings → Environment Variables. Detalle: docs/estandares/seguridad.md.

# ─── Proveedor de IA ─────────────────────────────────────────────────────────
# gemini (por defecto): Gemini directo con GOOGLE_GENERATIVE_AI_API_KEY.
# deepseek: implementado pero no adoptado; iría vía Vercel AI Gateway con zeroDataRetention.
AI_PROVIDER=gemini

# Clave de Gemini (SÍ se define, también en Vercel). Hoy se usa el nivel gratuito: Google puede
# usar los prompts para mejorar sus productos y la cuota es por proyecto y por modelo
# (~20 solicitudes/día). Activar facturación en el proyecto no requiere cambios de código.
GOOGLE_GENERATIVE_AI_API_KEY=

# NO definir salvo que se adopte Vercel AI Gateway. Si se define, Gemini pasa por el gateway con retención cero (requiere
# créditos del gateway). Con AI_PROVIDER=deepseek es obligatoria (o OIDC en Vercel).
AI_GATEWAY_API_KEY=

# Opcional (solo con gateway): proveedores de inferencia permitidos, separados por coma.
# Por defecto para DeepSeek: baseten,fireworks,togetherai,digitalocean,parasail (EE.UU., con ZDR).
AI_GATEWAY_PROVIDERS=

# Opcional: forzar un modelo por agente (cambiarlo exige correr el golden set).
# Ej.: AI_MODEL_SINTETIZADOR=gemini-3-flash-preview
AI_MODEL_ENTREVISTADOR=
AI_MODEL_ANALISTA=
AI_MODEL_SINTETIZADOR=

# ─── Kill switch ─────────────────────────────────────────────────────────────
# false → /api/chat y /api/diagnostico responden 503 antes de llamar al modelo.
DIAGNOSTICO_ENABLED=true

# ─── Acceso del piloto ───────────────────────────────────────────────────────
# open: sin código. passcode: exige código en /diagnostico/acceso.
ACCESS_MODE=open
# Códigos separados por coma, con etiqueta opcional: CODIGO:etiqueta. Mínimo 6 caracteres.
# Quitar un código lo revoca de inmediato (también para quien ya entró).
ACCESS_CODES=
# Secreto para firmar el JWT de acceso (HS256). Mínimo 32 caracteres aleatorios:
#   openssl rand -base64 48
ACCESS_JWT_SECRET=

# ─── Logs ────────────────────────────────────────────────────────────────────
# Sal para el hash de IP en los logs (no se guarda la IP).
LOG_IP_SALT=
